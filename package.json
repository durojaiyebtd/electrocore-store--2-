{
  "name": "electrocore-store",
  "version": "1.0.0",
  "private": true,
  "description": "E-commerce platform for MAGNIFICENT ELECTROCORE SYNERGY LTD (RC No: 9792926) \u2014 Next.js App Router, Prisma + MongoDB, Paystack.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/db-sync.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "db:studio": "prisma studio",
    "seed:admin": "tsx --env-file=.env scripts/seed-admin.ts",
    "setup": "npm run db:push && npm run db:seed",
    "supplier:sync": "tsx --env-file=.env scripts/sync-supplier.ts",
    "catalog:import": "node scripts/import-full-catalog.js",
    "catalog:technocrat": "tsx --env-file=.env scripts/sync-supplier.ts technocrat --replace-demo",
    "art:generate": "tsx scripts/generate-product-art.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.2",
    "jose": "^5.9.6",
    "next": "^15.5.7",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^6.16.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
