# =============================================================================
#  MAGNIFICENT ELECTROCORE SYNERGY LTD — Environment configuration
#  1. Copy this file:   cp .env.example .env
#  2. Fill in every value marked REQUIRED.
#  3. Never commit .env to Git (it is already in .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (REQUIRED)
# MongoDB connection string. Prisma needs MongoDB running as a *replica set*.
#  - MongoDB Atlas (free tier) is already a replica set — recommended.
#    Format: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/electrocore?retryWrites=true&w=majority
#  - Local Docker (see docker-compose.yml):
#    mongodb://localhost:27017/electrocore?replicaSet=rs0&directConnection=true
# -----------------------------------------------------------------------------
DATABASE_URL="mongodb://localhost:27017/electrocore?replicaSet=rs0&directConnection=true"

# -----------------------------------------------------------------------------
# PAYSTACK (REQUIRED for real payments)
# Get keys at https://dashboard.paystack.com/#/settings/developers
# Use sk_test_ / pk_test_ keys while developing, sk_live_ / pk_live_ in production.
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Set to "true" to simulate successful payments locally WITHOUT Paystack keys.
# Ignored automatically when NODE_ENV=production (cannot be enabled on a live site).
PAYSTACK_MOCK_MODE="false"

# -----------------------------------------------------------------------------
# AUTH (REQUIRED)
# Random string of at least 32 characters used to sign login sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# -----------------------------------------------------------------------------
AUTH_SECRET="replace-with-a-long-random-string-of-at-least-32-characters"

# -----------------------------------------------------------------------------
# CUSTOM DOMAIN / APP URL (REQUIRED)
# NEXT_PUBLIC_APP_URL is used for Paystack callback URLs and links in the site.
# Local:       http://localhost:3000
# Production:  https://www.your-domain.com.ng
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_DOMAIN="localhost"
# Comma-separated list of extra hostnames you serve the store on (informational; used in docs/metadata)
SITE_ALT_DOMAINS="electrocore.com.ng,www.electrocore.com.ng"

# -----------------------------------------------------------------------------
# BUSINESS DETAILS (shown in the footer, contact page and policies)
# Replace with your CAC-registered office address and real support lines.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_BUSINESS_ADDRESS_LINE1="Your registered office street address"
NEXT_PUBLIC_BUSINESS_CITY="Lagos"
NEXT_PUBLIC_BUSINESS_STATE="Lagos State"
NEXT_PUBLIC_SUPPORT_PHONE="+234 800 000 0000"
NEXT_PUBLIC_BUSINESS_HOURS="Mon – Sat, 8:00am – 6:00pm WAT"

# -----------------------------------------------------------------------------
# CURRENCY
# Catalog prices are stored in NGN kobo. Switch the storefront to USD by setting
# NEXT_PUBLIC_STORE_CURRENCY="USD" — prices are converted with the rate below,
# and Paystack is charged in USD (your Paystack account must have USD enabled).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STORE_CURRENCY="NGN"
NEXT_PUBLIC_NGN_PER_USD="1550"
# Orders at or above this amount (in Naira) get free delivery.
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD_NGN="500000"

# -----------------------------------------------------------------------------
# RESELLER / SUPPLIER FEED
# SUPPLIER_PROVIDER = "technocrat" (your catalog in src/data/products.json — default),
#                     "mock" (built-in demo catalog) or
#                     "http" (external wholesale API, format in src/lib/suppliers/http-supplier.ts)
# -----------------------------------------------------------------------------
SUPPLIER_PROVIDER="technocrat"
# The Technocrat file only says in/out of stock; in-stock items start with this many units.
# Set real counts afterwards in Admin → Inventory.
TECHNOCRAT_DEFAULT_STOCK="10"
SUPPLIER_API_URL="https://api.your-wholesaler.com/v1"
SUPPLIER_API_KEY=""
# Percentage added on top of supplier cost prices (e.g. 18 = +18%)
SUPPLIER_MARKUP_PERCENT="18"

# Admin account created by `npm run db:seed` (set your own before seeding)
SEED_ADMIN_EMAIL="admin@your-domain.com.ng"
SEED_ADMIN_PASSWORD="choose-a-strong-password"

# Token required to trigger POST /api/admin/sync (e.g. from a cron job)
ADMIN_API_TOKEN="replace-with-another-long-random-string"

# --- Password-reset emails (admin "Forgot password") ---
# Gmail example: host smtp.gmail.com, port 465, user = the Gmail address, pass = a Google App Password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="magnificantelectrocoresynergy@gmail.com"
SMTP_PASS="your-google-app-password"
SMTP_FROM="Magnificent ElectroCore <magnificantelectrocoresynergy@gmail.com>"
